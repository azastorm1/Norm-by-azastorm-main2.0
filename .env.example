# Скопируйте этот файл в .env и заполните.
# Пароль для входа в админ-панель (/admin). Обязательно.
ADMIN_PASSWORD=придумайте-длинный-пароль

# Адрес сайта без слеша в конце (нужен для ссылок в уведомлениях и защищённых cookie)
PUBLIC_URL=http://localhost:3000

# Порт и папка с данными (база, загруженные фото). Папку нужно сохранять при обновлениях.
PORT=3000
DATA_DIR=./data
